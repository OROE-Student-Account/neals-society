[node name="DialogueRoot" type="Node" parent="Node2D/Kom Ma-King" unique_id=1360333292]
script = ExtResource("10_dialogue")
text = "Welcome to my academy! Semicolons and appositives are advanced tools. Are you ready for a lesson?"

[node name="SemicolonLesson" type="Node" parent="Node2D/Kom Ma-King/DialogueRoot" unique_id=1794429263 node_paths=PackedStringArray("func_node")]
script = ExtResource("10_dialogue")
is_end_node = true
option_name = "Begin the lesson"
text = "A semicolon joins two complete thoughts; an appositive adds detail beside the noun it renames. Now, show me what you have learned!"
function = "begin_battle"
func_node = NodePath("../../BattleStart")

[node name="FinalDialogue" type="Node" parent="Node2D/Kom Ma-King" unique_id=922101857]
script = ExtResource("10_dialogue")
is_end_node = true
text = "You have potential, but you aren't ready to tackle Team rammarG head-on. Polish up your vocabulary skills in Lluvia City, then return to your studies."

